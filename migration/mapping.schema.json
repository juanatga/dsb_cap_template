{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit capstone migration mapping",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "keep"
              },
              "replace_template": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "sha256",
              "reason",
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "copy"
              },
              "replace_template": {
                "type": "boolean"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))[^\\\\]+$"
              }
            },
            "required": [
              "source",
              "sha256",
              "reason",
              "action",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "remove"
              }
            },
            "required": [
              "source",
              "sha256",
              "reason",
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "const": "notebook"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "enum": [
                        "notebooks/01_eda.ipynb",
                        "notebooks/02_modelling.ipynb"
                      ]
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 13
                    },
                    "cells": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "index": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "replace": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "old": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "new": {
                                      "type": "string"
                                    },
                                    "reason": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "old",
                                    "new",
                                    "reason"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "index"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "enum": [
                                  "markdown",
                                  "code"
                                ]
                              },
                              "text": {
                                "type": "string"
                              },
                              "instruction": {
                                "type": "boolean"
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "type",
                              "text",
                              "reason"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "target",
                    "section",
                    "cells"
                  ],
                  "additionalProperties": false
                }
              },
              "omit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "source",
              "sha256",
              "reason",
              "action",
              "blocks",
              "omit"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "files"
  ],
  "additionalProperties": false
}
